# Polyglot Explainer — environment configuration (Track 2B)
# Copy to `.env` and fill in. `.env` is git-ignored (see track_2b/.gitignore);
# NEVER commit a real key. Without LLM_API_KEY the app runs in clearly-labeled
# demo mode, which is the judges' default on a clean checkout.
#
# Names are the HackApertus template-mandated ones (LLM_* primary;
# APERTUS_API_KEY / APERTUS_BASE_URL / APERTUS_MODEL are accepted fallbacks).

# Model id, e.g. swiss-ai/Apertus-v1.5-70B or swiss-ai/Apertus-v1.5-8B
LLM_NAME=swiss-ai/Apertus-v1.5-70B

# OpenAI-compatible endpoint base URL.
# LEFT EMPTY ON PURPOSE: set this to your real endpoint, e.g.
#   https://api.infomaniak.com/2/ai/<product>/openai/v1   (replace <product>)
# or a local Ollama: http://host.docker.internal:11434/v1
# The Infomaniak example with "<product>" is NOT expanded by the app —
# if left with an unexpanded placeholder, live mode refuses to call it.
LLM_BASE_URL=

# API key for the endpoint. Absent (or empty) => demo mode with labeled
# simulated outputs. This value is never committed, never logged.
LLM_API_KEY=

# Optional: upstream request timeout in seconds (default 120)
APERTUS_TIMEOUT=120
